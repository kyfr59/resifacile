{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-simplexml": "*",
        "ext-zip": "*",
        "barryvdh/laravel-dompdf": "^3.0",
        "bezhansalleh/filament-shield": "^4.3",
        "filament/filament": "^4.0",
        "filament/spatie-laravel-settings-plugin": "^4.0",
        "flowframe/laravel-trend": "^0.5",
        "guzzlehttp/guzzle": "^7.2",
        "hipay/hipay-fullservice-sdk-php": "^2.15",
        "http-interop/http-factory-guzzle": "^1.2",
        "jeffgreco13/filament-breezy": "^3.2",
        "laravel/folio": "^1.1",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.21",
        "laravel/octane": "^2.1",
        "laravel/sanctum": "^4.0",
        "laravel/scout": "^10.5",
        "laravel/telescope": "^5.0",
        "laravel/tinker": "^3.0",
        "league/csv": "^9.11",
        "league/flysystem-aws-s3-v3": "^3.22",
        "league/flysystem-sftp-v3": "^3.22",
        "livewire/livewire": "^3.2",
        "meilisearch/meilisearch-php": "^1.5",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.6",
        "smart-cms/redirects": "1.x-dev",
        "spatie/array-to-xml": "^3.2",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-settings": "^3.2",
        "spatie/laravel-sitemap": "^7.0",
        "spatie/laravel-sluggable": "^3.5",
        "spatie/laravel-webhook-client": "^3.2",
        "spatie/yaml-front-matter": "^2.0",
        "spiral/roadrunner": "^2023.3",
        "statikbe/laravel-cookie-consent": "^1.12",
        "symfony/http-client": "^7.4",
        "symfony/postmark-mailer": "^7.1",
        "tightenco/ziggy": "^2.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel-lang/lang": "^12.17",
        "laravel-lang/publisher": "^16.8",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.6",
        "spatie/laravel-ignition": "^2.0",
        "spatie/laravel-ray": "^1.33"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
